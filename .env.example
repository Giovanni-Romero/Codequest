# Copy this file to .env and adjust. Never commit .env

# ---- AI mentor (optional) ----
# The game is fully playable and fully educational with this off.
CODEQUEST_MENTOR_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud
OLLAMA_TIMEOUT_SECONDS=30

# ---- Sandbox ----
CODEQUEST_DEFAULT_TIMEOUT_MS=2000
CODEQUEST_DEFAULT_MEMORY_MB=128

# ---- Paths ----
CODEQUEST_CONTENT_DIR=content
CODEQUEST_SAVE_DIR=saves

# ---- Development ----
CODEQUEST_DEBUG=false
